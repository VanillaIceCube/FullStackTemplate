{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "fullstacktemplate",
  "version": "0.1.0",
  "description": "Starter ChatGPT package for a derived application; initialize and enable MCP before use.",
  "author": {
    "name": "Jude Andrew Alaba",
    "url": "https://github.com/VanillaIceCube"
  },
  "homepage": "https://app.example.com",
  "repository": "https://github.com/vanillaicecube/fullstack-template",
  "keywords": [
    "mcp",
    "template",
    "development"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "FullStackTemplate",
        "shortDescription": "Connect your application",
        "longDescription": "Starter connection for a derived FullStackTemplate application. Initialize the application, implement its tools, configure its HTTPS origin, enable MCP, and register the public OAuth client before connecting. The template sample only checks the authenticated connection.",
        "developerName": "Jude Andrew Alaba",
        "category": "Developer Tools",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://app.example.com",
        "supportURL": "https://github.com/vanillaicecube/fullstack-template/issues",
        "composerIcon": "./assets/logo.svg",
        "logo": "./assets/logo.svg",
        "defaultPrompt": [
          "Check my application connection."
        ]
      }
    }
  }
}
