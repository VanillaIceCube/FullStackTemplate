{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fullstacktemplate": {
      "type": "streamable-http",
      "url": "https://app.example.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "fullstacktemplate-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://app.example.com/auth/mcp/authorize/",
            "tokenUrl": "https://app.example.com/auth/mcp/token/",
            "baseScopes": [
              "fullstacktemplate:connect"
            ]
          }
        }
      }
    }
  }
}
