{
  "verified_on": "2026-10-20",
  "repository": "VanillaIceCube/FullStackTemplate",
  "ruleset_snapshot": {
    "id": 19855608,
    "name": "Main Branch Protection",
    "target": "branch",
    "source_type": "Repository",
    "source": "VanillaIceCube/FullStackTemplate",
    "enforcement": "active",
    "conditions": {
      "ref_name": {
        "exclude": [],
        "include": [
          "~DEFAULT_BRANCH"
        ]
      }
    },
    "rules": [
      {
        "type": "deletion"
      },
      {
        "type": "non_fast_forward"
      },
      {
        "type": "pull_request",
        "parameters": {
          "required_approving_review_count": 0,
          "dismiss_stale_reviews_on_push": false,
          "required_reviewers": [],
          "require_code_owner_review": false,
          "require_last_push_approval": false,
          "required_review_thread_resolution": true,
          "require_extra_approval_for_unattributed_changes": true,
          "allowed_merge_methods": [
            "merge",
            "squash",
            "rebase"
          ]
        }
      },
      {
        "type": "required_status_checks",
        "parameters": {
          "strict_required_status_checks_policy": false,
          "do_not_enforce_on_create": false,
          "required_status_checks": [
            {
              "context": "Lints / Detect Changes"
            },
            {
              "context": "Lints / Lint Frontend (ESLint + Prettier)"
            },
            {
              "context": "Lints / Lint Backend (Ruff)"
            },
            {
              "context": "Lints / Lint Results"
            },
            {
              "context": "Tests / Detect Changes"
            },
            {
              "context": "Tests / Frontend Tests (React)"
            },
            {
              "context": "Tests / Backend Tests (Django)"
            },
            {
              "context": "Tests / Test Results"
            },
            {
              "context": "CodeQL / Detect CodeQL Scope"
            },
            {
              "context": "CodeQL / Analyze Python"
            },
            {
              "context": "CodeQL / Analyze JavaScript/TypeScript"
            },
            {
              "context": "CodeQL / Analyze GitHub Actions"
            },
            {
              "context": "Vulnerability / Vulnerability"
            },
            {
              "context": "Malware / Malware"
            },
            {
              "context": "AI Code Review / Obi-Wan Code-nobi code review"
            },
            {
              "context": "AI Build Sheriff Review / Lint Eastwood build sheriff review"
            },
            {
              "context": "AI Security Review / RoboCop security review"
            },
            {
              "context": "Auto Merge"
            },
            {
              "context": "Tests / Automation Tests (Node)"
            }
          ]
        }
      }
    ],
    "node_id": "RRS_lACqUmVwb3NpdG9yec5ORpjdzgEu-Pg",
    "created_at": "2026-07-27T16:01:19.144-07:00",
